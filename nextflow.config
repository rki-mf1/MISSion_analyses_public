params {
    conda_cache_dir = "conda"
    singularity_cache_dir = "singularity"
    conda_create_options = ''
    conda_create_timeout = '20 min'

    analysesdir = null
    krakendb = null
    krakendb_contigs = null
    taxid = null
    mlst_mapping = null
    metaphlan_db = null
    reference_fasta = null
    reference_gff = null
}

profiles {
    mission_conda {
        conda {
                enabled = true
                cacheDir = params.conda_cache_dir
                createOptions = params.conda_create_options
                createTimeout = params.conda_create_timeout
        }
    } 


    mission_mamba {
        conda {
          useMamba = true
          enabled = true
          cacheDir = params.conda_cache_dir
          createOptions = params.conda_create_options
          createTimeout = params.conda_create_timeout
        }
    }

    mission_singularity {
        singularity { 
            enabled = true
            autoMounts = true
            envWhitelist = "HTTPS_PROXY,HTTP_PROXY,http_proxy,https_proxy,FTP_PROXY,ftp_proxy"
            cacheDir = params.singularity_cache_dir
        }
    }

    mission_slurm { 
        executor {
            name = "slurm"
            queueSize = 200
            // exitReadTimeout = "360 sec"
            // submitRateLimit = '1 / 2 s'
            // pollInterval = '30 sec'
        }
        process {
            cache = "lenient"
            // clusterOptions = '--signal=B:USR2'
        }
    }
}
